# Copy this file to .env and fill in the values, then restart `npm run dev`.
# Every variable is optional: without them the app still runs (places are
# kept in your browser only, no address search, public OpenStreetMap tiles).

# Supabase: Project Settings > API. Use the "publishable" key (older projects: "anon public"), never the secret / service_role key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# MapTiler (free account at https://cloud.maptiler.com/): map tiles + address search
VITE_MAPTILER_KEY=
# Optional: MapTiler map style (dataviz, streets-v2, toner-v2, ...)
VITE_MAPTILER_STYLE=dataviz

# Public address of the deployed site, used for link-preview tags (no trailing path needed)
VITE_SITE_URL=
